# ============================================================ Samvaad app
# Ritu's brain. auto = first of Gemini, Claude, Sarvam that has a key.
AI_PROVIDER=auto
# Free key from Google AI Studio. Free tier: Google may use the data to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Claude (paid, pay per use from the Claude Console). Also reads CIBIL report PDFs.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Your support number for the app's "Call us" button, with 91 in front, e.g. 919845012345
SUPPORT_PHONE=

# Database + sign-in (Supabase: Project Settings -> API). Leave empty to use local test mode on your laptop.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# The service_role key. Server only: never put it in the browser or on GitHub.
SUPABASE_SERVICE_KEY=
# 1 once you've switched on Google sign-in in Supabase
SUPABASE_GOOGLE_LOGIN=0

# Signs the login cookie. Required on Vercel. Any long random string.
SECRET_KEY=
# Emails allowed into /admin, comma separated
ADMIN_EMAILS=huzzii1267@gmail.com

# Sarvam AI: voice for Ask Ritu (speech to text + Ritu's voice) and the calling tools
SARVAM_API_KEY=

# Real phone calls through Twilio (Phone page, auto_caller.py --mode twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number Ritu calls from, e.g. +15551234567
TWILIO_PHONE_NUMBER=
# Your app's public https link (cloudflared tunnel or Railway), no trailing slash
PUBLIC_BASE_URL=https://your-link.trycloudflare.com
# A password you choose. The Phone page asks for it before placing a call.
CALL_ACCESS_KEY=
# Hours (India time) when calls may be placed. Sales calls: 9-21. Testing with your own number: 0-24
CALL_HOURS=9-21

# WhatsApp follow-ups through Twilio (scripts/whatsapp.py)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Exotel (older integration, optional)
EXOTEL_SID=
EXOTEL_TOKEN=
EXOTEL_VIRTUAL_NUMBER=
EXOTEL_CALLBACK_BASE_URL=

# Flask
PORT=5000
