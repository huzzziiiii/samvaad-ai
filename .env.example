# Required — Sarvam AI (voice, listening, replies)
SARVAM_API_KEY=

# Real phone calls through Twilio (Phone page, auto_caller.py --mode twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number Ritu calls from, e.g. +15551234567
TWILIO_PHONE_NUMBER=
# Your app's public https link (cloudflared tunnel or Railway), no trailing slash
PUBLIC_BASE_URL=https://your-link.trycloudflare.com
# A password you choose. The Phone page asks for it before placing a call.
CALL_ACCESS_KEY=
# Hours (India time) when calls may be placed. Sales calls: 9-21. Testing with your own number: 0-24
CALL_HOURS=9-21

# WhatsApp follow-ups through Twilio (scripts/whatsapp.py)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Exotel (older integration, optional)
EXOTEL_SID=
EXOTEL_TOKEN=
EXOTEL_VIRTUAL_NUMBER=
EXOTEL_CALLBACK_BASE_URL=

# Flask
PORT=5000
